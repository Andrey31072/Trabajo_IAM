POSTGRES_DB=iam_db
POSTGRES_USER=iam_app
POSTGRES_PASSWORD=iam_app_password
DATABASE_URL=postgres://iam_app:iam_app_password@postgres:5432/iam_db
DEMO_PASSWORD=Demo2026!
IAM_DB_DIR=./design-software-iam-db-main


# URL publica del frontend usada en los enlaces enviados por correo.
APP_PUBLIC_URL=http://localhost:8080

# SMTP real con Gmail. Usa una contrasena de aplicacion, no tu contrasena normal.
# 1) Activa verificacion en dos pasos en la cuenta Google.
# 2) Crea una App password para "Mail".
# 3) Pega esa clave de 16 caracteres en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-google
EMAIL_FROM="SENA IAM <tu-correo@gmail.com>"
EMAIL_DELIVERY_REQUIRED=false
